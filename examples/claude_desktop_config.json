{
  "mcpServers": {
    "magento": {
      "command": "php",
      "args": [
        "/path/to/magento2-mcp-server/bin/magento-mcp-server"
      ],
      "env": {
        "MAGENTO_BASE_URL": "https://mystore.example.com",
        "MAGENTO_ACCESS_TOKEN": "YOUR_MAGENTO_INTEGRATION_TOKEN",
        "MAGENTO_STORE_CODE": "default",
        "MAGENTO_READ_ONLY": "true",
        "MAGENTO_TIMEOUT": "30"
      }
    }
  }
}
